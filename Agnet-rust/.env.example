# aagnet 环境变量模板
# 复制本文件为 .env 并填入实际值

# ── LLM Provider 配置 ──
# 支持的 provider: openai, anthropic, ollama, openai_compatible
# AAGNET_LLM_PROVIDER=openai

# ── LLM 模型配置 ──
# 模型名称（必需）
# AAGNET_LLM_MODEL=gpt-4o

# API 密钥（OpenAI / Anthropic 需要，Ollama 不需要）
# AAGNET_LLM_API_KEY=your-api-key-here

# API 基础 URL（OpenAiCompatible 必须设置，其他 provider 有默认值）
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com
# Ollama: http://localhost:11434
# AAGNET_LLM_BASE_URL=https://api.openai.com/v1

# ── LLM 参数 ──
# 最大输出 token 数
# AAGNET_LLM_MAX_TOKENS=4096

# 温度参数（0.0-2.0）
# AAGNET_LLM_TEMPERATURE=0.7

# 请求超时（秒）
# AAGNET_LLM_TIMEOUT=60

# 最大重试次数（0 表示不重试）
# AAGNET_LLM_MAX_RETRIES=3

# ── 功能开关 ──
# 是否启用多模态（true/false），关闭时忽略图片/音频/文件输入
# AAGNET_LLM_MULTIMODAL=false

# 是否启用流式响应（true/false）
# AAGNET_LLM_STREAM=false

# 是否启用工具调用（true/false）
# AAGNET_LLM_TOOLS=true

# 是否启用详细追踪日志（true/false）
# AAGNET_LLM_TRACING=false

# ── Agent 配置 ──
# AAGNET_AGENT_MAX_TURNS=10
# AAGNET_AGENT_SYSTEM_PROMPT=你是一个有帮助的助手

# ── 次要 LLM ──
# 设置为 true 启用次要 LLM（用于并行评估或验证）
# AAGNET_USE_DUAL_LLM=false

# ── 日志级别 ──
# AAGNET_LOG_LEVEL=info
